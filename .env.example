# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres from docker-compose.yml (host port 5433 avoids clashing with a
# local Postgres on 5432).
DATABASE_URL="postgresql://clinic:clinic_dev_password@localhost:5433/clinic_db?schema=public"
TEST_DATABASE_URL="postgresql://clinic:clinic_dev_password@localhost:5433/clinic_db_test?schema=public"

# Auth.js session signing key. Generate one:  openssl rand -base64 48
AUTH_SECRET=""

# Absolute public origin — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seeded staff account. Password must be 12+ chars with upper, lower and a digit.
SEED_ADMIN_EMAIL="admin@meridianclinic.example"
SEED_ADMIN_NAME="Clinic Administrator"
SEED_ADMIN_PASSWORD=""
